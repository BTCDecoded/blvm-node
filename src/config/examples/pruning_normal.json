{
  "listen_addr": "127.0.0.1:8333",
  "transport_preference": "tcp_only",
  "max_peers": 100,
  "protocol_version": "BitcoinV1",
  "storage": {
    "database_backend": "auto",
    "data_dir": "data",
    "pruning": {
      "mode": "normal",
      "keep_blocks": 288,
      "auto_prune": true
    },
    "cache": {
      "block_cache_mb": 100,
      "utxo_cache_mb": 50,
      "header_cache_mb": 10
    }
  }
}

